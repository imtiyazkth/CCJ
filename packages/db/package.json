{
  "name": "@ccj/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/schema.js",
  "exports": {
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed.ts",
    "studio": "drizzle-kit studio",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "@supabase/supabase-js": "^2.47.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.17.0",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "types": "./dist/schema.d.ts"
}
