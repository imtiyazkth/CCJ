# ══════════════════════════════════════════════════════════════
# CCJ Environment Variables
# Copy to .env — NEVER commit .env
# Minimum for Android/Termux dev: only SUPABASE_* required
# ══════════════════════════════════════════════════════════════

# ── REQUIRED on Android/Termux ────────────────────────────────
# Get from https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Supabase PostgreSQL connection string
# Get from Supabase → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# ── APP ────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ── PROVIDER MODE ─────────────────────────────────────────────
# "demo"    → No external services needed (default for Android)
# "live"    → Use real providers below
PROVIDER_MODE=demo

# ── OPTIONAL: Search Providers (live mode only) ───────────────
SEARXNG_URL=http://localhost:8888
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# ── OPTIONAL: AI Providers (server-side only — NEVER in browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# ── OPTIONAL: Translation ─────────────────────────────────────
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# ── OPTIONAL: Vector DB ───────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── OPTIONAL: News ────────────────────────────────────────────
NEWSAPI_KEY=
GDELT_ENABLED=false

# ── OPTIONAL: Internal worker auth ───────────────────────────
# Only needed when running research-worker separately
WORKER_SECRET=

# ── OPTIONAL: Redis (in-memory fallback is used by default) ──
REDIS_URL=

# ── DOCKER ONLY: PostgreSQL + Redis passwords ─────────────────
POSTGRES_USER=ccj
POSTGRES_PASSWORD=
POSTGRES_DB=ccj_dev
REDIS_PASSWORD=
SEARXNG_SECRET_KEY=
QDRANT_API_KEY=changeme_local
