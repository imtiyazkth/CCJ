# ══════════════════════════════════════════════════════════════
# CCJ — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=ccj
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ccj_dev

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── Auth / JWT ────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Worker Internal Auth ──────────────────────────────────────
# Shared secret between API and research-worker. openssl rand -hex 32
WORKER_SECRET=

# ── SearXNG ───────────────────────────────────────────────────
SEARXNG_SECRET_KEY=change_me_searxng_secret

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_API_KEY=changeme_local

# ── Translation ───────────────────────────────────────────────
LIBRETRANSLATE_API_KEY=

# ── Optional AI Providers (server-side only — NEVER in browser) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
NEWSAPI_KEY=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development
